{
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/player/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "rewrites": [
      {
        "source": "/player/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "rewrites": [
      {
        "source": "/player/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/player/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/data/**",
        "rewrites": [
      {
        "source": "/player/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
